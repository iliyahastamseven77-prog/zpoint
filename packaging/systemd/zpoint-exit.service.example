[Unit]
Description=Zpoint exit daemon (E2E-encrypted relay to real TCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust both paths to match your install and the kit generated by `zpoint` (menu option 1).
ExecStart=/usr/bin/python3 /opt/zpoint/bin/zpointd serve exit /opt/zpoint/configs/server-XXXX.server.zpoint
Restart=always
RestartSec=5
WorkingDirectory=/opt/zpoint

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
ReadWritePaths=/opt/zpoint/configs

[Install]
WantedBy=multi-user.target